{
  "name": "form-gym-companion",
  "version": "1.2.1",
  "private": true,
  "description": "Offline Android gym companion with SVG guides, vegetarian nutrition and local music",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/core.test.cjs tests/nutrition.test.cjs tests/visuals.test.cjs",
    "test:ui": "node tests/ui.test.cjs && node tests/nutrition-ui.test.cjs",
    "gallery": "node scripts/capture-exercise-gallery.cjs",
    "build:apk": "bash scripts/build-apk.sh"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
